{
  "name": "@toolkitosc/shared-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "schema:controls": "ts-json-schema-generator --path src/types/controls.ts --type ControlType --no-type-check --expose none -o control-types.schema.json"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.4",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0"
  }
}
