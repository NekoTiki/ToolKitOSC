{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolKitOSC",
  "version": "1.0.0",
  "identifier": "io.github.nekotiki.toolkitosc",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolKitOSC",
        "width": 900,
        "height": 670,
        "minWidth": 700,
        "minHeight": 500,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://api.iconify.design https://api.openshock.app http://localhost:3000 ws://localhost:3000 wss://localhost:3000; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ui-avatars.com https://cdn.discordapp.com; connect-src 'self' https://api.iconify.design https://api.openshock.app http://localhost:3000 ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4NzJDNkY0OTExN0FGMEMKUldRTXJ4ZVI5TVp5aUJWUjAwSkFFZkkvdWtseEMrVEdKUmtTeHFsMHVJRFlxT1kra0tld1pvVlgK",
      "endpoints": [
        "https://github.com/NekoTiki/ToolKitOSC/releases/latest/download/latest.json"
      ]
    }
  }
}
