{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "*.d.ts",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "paths": {
      "@renderer/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}
