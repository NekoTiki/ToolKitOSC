# Session/auth
# Secret used to sign both the browser session cookie (nuxt-auth-utils) and the desktop client's
# long-lived JWT (see server/routes/auth/desktop/confirm.get.ts, server/utils/verifyDesktopToken.ts).
NUXT_SESSION_PASSWORD=

# Discord OAuth app credentials (https://discord.com/developers/applications) - used for the
# browser-side login flow that mints the desktop client's token.
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=

# AI control-suggestion feature (see server/utils/ai)
# Each provider below is independent and optional - one with no API key set is simply reported
# "not configured" to the client rather than the app failing to boot. Model choice is entirely
# server-side (never a client-supplied string, see profiles.ts's resolveModel); the *Model value
# here is what's used for the 'balanced'/'heavy' prompt profiles, 'light' uses a hardcoded
# smaller/faster model per provider where one is known.

# Groq (https://console.groq.com) - fast, free tier, no card required.
NUXT_GROQ_API_KEY=
NUXT_GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (https://aistudio.google.com) - the full 'flash' tier returned transient 503s in
# testing against a fresh key; 'flash-lite' answered reliably and has the more generous free quota.
NUXT_GEMINI_API_KEY=
NUXT_GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter (https://openrouter.ai) - aggregates many models/providers behind one API; not every
# model it offers supports strict json_schema structured output, only the one configured here does.
NUXT_OPENROUTER_API_KEY=
NUXT_OPENROUTER_MODEL=openai/gpt-oss-120b

# Cerebras (https://cloud.cerebras.ai) - very fast inference, smaller model selection (check
# GET https://api.cerebras.ai/v1/models against your own key before assuming a model id still
# exists - the catalog has changed under us before).
NUXT_CEREBRAS_API_KEY=
NUXT_CEREBRAS_MODEL=gpt-oss-120b

# Cloudflare Workers AI (https://dash.cloudflare.com -> AI -> Workers AI) - needs BOTH an API
# token and the account id it belongs to; missing either leaves this provider "not configured".
NUXT_CLOUDFLARE_API_KEY=
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# AI feature access control (see server/utils/ai/access.ts, server/utils/isAdmin.ts)
# Comma-separated Discord ids allowed to manage /dashboard and the AI allowlist. Admins
# automatically get full AI access + model-select permission too, without a database row.
NUXT_AI_ADMIN_DISCORD_IDS=
# Provider/profile used for accounts without model-select permission (the default for anyone an
# admin grants access to). Leave NUXT_AI_DEFAULT_PROVIDER unset to fall back to the first
# configured provider in a fixed preference order (gemini, groq, openrouter, cerebras, cloudflare).
NUXT_AI_DEFAULT_PROVIDER=
NUXT_AI_DEFAULT_PROFILE=balanced

# Where the sqlite database file (drizzle + node:sqlite) is written - the Docker image's
# docker-compose.yml mounts a host volume here so it survives container rebuilds.
NUXT_SQLITE_PATH=./data/app.db
